# Copy this file to  .env  and fill in your own values.
#   cp .env.example .env
# .env is gitignored — your real values never get committed.

# ── Telegram alerts (optional) ───────────────────────────────────────────────
# Create a bot with @BotFather to get the token.
# For a channel: add the bot as ADMIN, then use the channel id (starts with -100).
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard ────────────────────────────────────────────────────────────────
WEB_PORT=5010
# 127.0.0.1 = this machine only | 0.0.0.0 = reachable from your LAN
WEB_HOST=127.0.0.1

# ── Display timezone (display only — internals always stay UTC) ──────────────
# Offset in MINUTES from UTC.  IST=330, CET=60, EST=-300, UTC=0
DISPLAY_TZ_LABEL=UTC
DISPLAY_OFFSET_MIN=0

# ── Signal timing ────────────────────────────────────────────────────────────
# false = alert intra-bar the moment a condition holds (live, can repaint)
# true  = alert only when the candle closes (fewer, confirmed)
EMIT_ON_CLOSE_ONLY=false

# ── ngrok public tunnel (optional) ───────────────────────────────────────────
# ⚠ Makes your dashboard reachable from the public internet.
NGROK_ENABLED=false
NGROK_PATH=
